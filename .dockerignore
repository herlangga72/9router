# VCS
.git
**/.git
.github

# Editor / CI
.vscode
**/.vscode
.cursor
**/.cursor
.captainignore

# Dependencies and build output (rebuilt in the image)
node_modules
**/node_modules
.next
**/.next
.next-cli-build
out
build
**/build
dist
**/dist
coverage
.eslintcache

# Runtime data and logs
data
logs

# Local env files (inject at runtime via --env-file or -e)
.env
.env.*
!.env.example

# Docs / non-runtime trees (not referenced by `next build` or the server)
docs
gitbook
cli
i18n
images
skills
tests
*.md

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*

# Docker metadata that must not be part of the build context
Dockerfile*
docker-compose*.yml
.dockerignore
captain-definition
start.sh
